# ============================================================
# AtlasFunding — Environment Variables
# Copy this file to .env and fill in your keys
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# MongoDB — local default works out of the box
MONGODB_URI=mongodb://localhost:27017/atlasfunding

JWT_SECRET=

GROQ_API_KEY=

# Firecrawl — for running the scraper script only
FIRECRAWL_API_KEY=

# Frontend URL (for CORS in production)
CLIENT_URL=http://localhost:5173
