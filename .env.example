# ============================================================
# AtlasFunding — Environment Variables
# Copy this file to .env and fill in your keys
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# MongoDB — local default works out of the box
MONGODB_URI=mongodb://localhost:27017/atlasfunding

JWT_SECRET=

GROQ_API_KEY=

# Jina Reader — free page→markdown scraper. Optional; a free key raises the
# rate limit from ~20 to ~100 req/min. Used FIRST in the scraper pipeline.
JINA_API_KEY=

# Firecrawl — used as a FALLBACK for anti-bot / JS-heavy pages the scraper
# cannot fetch via Jina, and to augment discovery. Optional reserve.
FIRECRAWL_API_KEY=

# Frontend URL (for CORS in production)
CLIENT_URL=http://localhost:5173

# ── Rate limiting (optional — sensible defaults in src/config/rate-limit.js) ──
# All values are optional. Omit to use the defaults.
# Windows in milliseconds; Max = allowed requests per window.
RATE_LIMIT_AUTH_WINDOW=900000       # 15 min — auth routes (register/login), per-IP
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_ACCOUNT_WINDOW=900000    # 15 min — per-account companion to auth
RATE_LIMIT_ACCOUNT_MAX=5
RATE_LIMIT_PUBLIC_WINDOW=60000      # 1 min — public endpoints (lists/search/questions)
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_USER_WINDOW=60000        # 1 min — authenticated user actions
RATE_LIMIT_USER_MAX=120
