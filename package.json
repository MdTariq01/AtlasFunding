{
  "name": "scholarship-finder",
  "version": "1.0.0",
  "description": "AtlasFunding — Scholarship Matching Platform for Indian Students",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev",
    "seed": "node scripts/seed.js",
    "add": "node scripts/add.js",
    "scrape": "node scripts/scrape.js",
    "scrape:url": "node scripts/scrape.js --url",
    "cleanup": "node scripts/cleanup.js",
    "cleanup:dry": "node scripts/cleanup.js --dry-run",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server.js"
  },
  "keywords": [
    "scholarship",
    "india",
    "education",
    "funding"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "groq-sdk": "^1.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.9.1",
    "morgan": "^1.11.0"
  }
}
